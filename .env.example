# Resend API Configuration
RESEND_API_KEY=api_key_here

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=client_id_here
GITHUB_CLIENT_SECRET=client_secret_here

# Admin Owner Account
ADMIN_OWNER_ACCOUNT=owner_username_here

# Database Connection Configuration (Prisma)
DATABASE_URL="mysql://username:password@localhost:3306/database_name"

# Maintenance Mode Configuration
# MAINTENANCE_MODE Overrides Admin Option, BYPASS_KEY Acts As Default
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_KEY=your_bypass_key_here

# Google Tag Manager Configuration
GTM_ID=GTM-XXXXXXX

# Region Lock Configuration
# ALLOWED_COUNTRIES is a comma-separated list of 2-letter ISO country codes (default: GB)
ALLOWED_COUNTRIES=GB
BYPASS_REGION_LOCK=false
BLOCK_UNDETECTED_REGIONS=false

# GeoIP API Configuration
# GEOIP_API_KEY is the authentication key for the GeoIP service. If not provided, region lock is bypassed.
# GEOIP_API_URL is the address of the GeoIP REST service (e.g. http://localhost:6099 or http://geoip-api:9000).
GEOIP_API_KEY=
GEOIP_API_URL=http://localhost:6099